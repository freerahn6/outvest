---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { isLive, fmtDate } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';

// ─────────────────────────────────────────────────────────────
// 관리자 콘솔
//   · 대시보드 — 빌드 시점의 콘텐츠 통계 (정적)
//   · 글관리   — /api/admin/* 로 GitHub 저장소를 직접 읽고 쓴다 (동적)
//
// 인증은 서버(Pages Functions)가 한다. 이 페이지에 비밀번호는 없다.
// ─────────────────────────────────────────────────────────────
const posts = (await getCollection('posts', isLive)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

type Series = '시황' | '기초강의' | '종목분석';
const seriesOf = (tags: string[]): Series =>
  tags.includes('시황') ? '시황' : tags.includes('기초강의') ? '기초강의' : '종목분석';

const seriesCount: Record<Series, number> = { 시황: 0, 기초강의: 0, 종목분석: 0 };
const tickerSet = new Set<string>();
const monthMap = new Map<string, number>();
const tagMap = new Map<string, number>();

for (const p of posts) {
  seriesCount[seriesOf(p.data.tags)]++;
  for (const t of p.data.tickers ?? []) tickerSet.add(t.code);
  const d = p.data.pubDate;
  const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  monthMap.set(ym, (monthMap.get(ym) ?? 0) + 1);
  for (const tag of p.data.tags ?? []) tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
}

const tiles = [
  { label: '게시된 글', value: posts.length },
  { label: '기초강의', value: seriesCount['기초강의'] },
  { label: '종목분석', value: seriesCount['종목분석'] },
  { label: '시황', value: seriesCount['시황'] },
  { label: '다룬 종목', value: tickerSet.size },
];

const months = [...monthMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const monthMax = Math.max(1, ...months.map(([, n]) => n));
const topTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);

// 편집 폼의 선택지 — 빌드 시점에 실제 파일에서 뽑는다.
const covers = fs
  .readdirSync('public/images')
  .filter((f) => f.startsWith('cover-') && f.endsWith('.svg'))
  .sort()
  .map((f) => `/images/${f}`);

// content.config.ts 의 category enum 과 일치해야 한다.
const categories = ['기초강의', '종목 분석', '장전 시황'];
const allTags = [...tagMap.keys()].sort();
const config = { covers, categories, allTags };
---

<BaseLayout title="관리자" noindex={true}>
  <script type="application/json" id="admin-config" set:html={JSON.stringify(config)} />

  <!-- 잠금 화면: 아는 사람만 '습' 한 글자를 누른다 -->
  <div class="lock" id="lockScreen">
    <p class="lock-msg">페이지를 볼 수 있는 권한이 없<span id="trigger" class="trg">습</span>니다.</p>
  </div>

  <!-- 비밀번호 레이어 -->
  <div class="ov" id="overlay" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-label="관리자 인증">
      <button class="modal-x" id="closeBtn" aria-label="닫기" type="button">&times;</button>
      <h2 class="modal-title">관리자 인증</h2>
      <input
        id="pw"
        class="pw-input"
        type="password"
        autocomplete="current-password"
        placeholder="비밀번호"
        aria-label="비밀번호"
      />
      <p class="pw-error" id="pwError" hidden></p>
      <button class="pw-submit" id="submitBtn" type="button">확인</button>
    </div>
  </div>

  <!-- ───────────────────────── 콘솔 ───────────────────────── -->
  <div class="wide console" id="console" hidden>
    <header class="c-head">
      <div>
        <p class="eyebrow">ADMIN</p>
        <h1 id="cTitle">콘텐츠 대시보드</h1>
      </div>
      <nav class="c-tabs">
        <button class="tab is-on" data-view="dash" type="button">대시보드</button>
        <button class="tab" data-view="list" type="button">글관리</button>
        <button class="ghost-btn" id="logoutBtn" type="button">잠그기</button>
      </nav>
    </header>

    <!-- ── 대시보드 ── -->
    <section class="view" id="view-dash">
      <div class="tiles">
        {tiles.map((t) => (
          <div class="tile">
            <span class="tile-val">{t.value}</span>
            <span class="tile-label">{t.label}</span>
          </div>
        ))}
      </div>

      <div class="cols">
        <section class="panel">
          <h2 class="panel-title">최근 글</h2>
          <div class="rlist">
            {posts.slice(0, 8).map((p) => (
              <a class="ritem" href={`/posts/${p.id}/`}>
                <span class="ri-title">{p.data.title}</span>
                <span class="ri-meta">
                  <span class="badge">{seriesOf(p.data.tags)}</span>
                  <span class="ri-date">{fmtDate(p.data.pubDate)}</span>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="panel">
          <h2 class="panel-title">태그 분포 Top 10</h2>
          <div class="taglist">
            {topTags.map(([tag, n]) => (
              <div class="tagrow">
                <span class="tag-name">{tag}</span>
                <span class="tag-count">{n}</span>
              </div>
            ))}
          </div>
        </section>
      </div>

      <section class="panel">
        <h2 class="panel-title">월별 발행 추이</h2>
        <div class="months">
          {months.map(([ym, n]) => (
            <div class="mrow">
              <span class="m-label">{ym}</span>
              <span class="m-bar-wrap"><span class="m-bar" style={`width:${(n / monthMax) * 100}%`}></span></span>
              <span class="m-count">{n}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="panel">
        <h2 class="panel-title">실시간 방문 통계</h2>
        <p class="muted small">
          방문자·조회수는 외부 애널리틱스에서 확인합니다. (수집 도구 미설치 — 콘텐츠 통계만 표시)
        </p>
        <div class="btn-row">
          <a class="ghost-btn" href="https://search.google.com/search-console" target="_blank" rel="noopener">구글 서치콘솔 ↗</a>
          <a class="ghost-btn" href="https://searchadvisor.naver.com" target="_blank" rel="noopener">네이버 서치어드바이저 ↗</a>
        </div>
      </section>
    </section>

    <!-- ── 글관리 목록 ── -->
    <section class="view" id="view-list" hidden>
      <div class="toolbar">
        <button class="primary-btn" id="newBtn" type="button">+ 새 글</button>
        <select id="fStatus" class="inp inp-sm" aria-label="상태 필터">
          <option value="">전체 상태</option>
          <option value="published">게시</option>
          <option value="scheduled">예약</option>
          <option value="draft">비공개</option>
        </select>
        <input id="fSearch" class="inp inp-sm" type="search" placeholder="제목·주소 검색" aria-label="검색" />
        <button class="ghost-btn" id="reloadBtn" type="button">새로고침</button>
        <span class="spacer"></span>
        <span class="muted small" id="listCount"></span>
      </div>

      <p class="notice" id="listNotice" hidden></p>

      <div class="table-wrap">
        <table class="ptable">
          <thead>
            <tr>
              <th>상태</th><th>제목</th><th>카테고리</th><th>발행일시</th><th class="ta-r">관리</th>
            </tr>
          </thead>
          <tbody id="listBody">
            <tr><td colspan="5" class="empty">불러오는 중…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 편집 ── -->
    <section class="view" id="view-edit" hidden>
      <div class="edit-head">
        <button class="ghost-btn" id="backBtn" type="button">← 목록</button>
        <span class="muted small" id="editWhich"></span>
        <span class="spacer"></span>
        <button class="ghost-btn danger" id="delBtn" type="button" hidden>삭제</button>
        <button class="primary-btn" id="saveBtn" type="button">저장</button>
      </div>

      <p class="notice" id="editNotice" hidden></p>

      <div class="edit-grid">
        <!-- 메타 -->
        <div class="panel meta-panel">
          <label class="fld">
            <span class="fld-label">제목 <b>*</b></span>
            <input id="f-title" class="inp" type="text" maxlength="200" />
          </label>

          <label class="fld">
            <span class="fld-label">요약 <b>*</b> <em id="descCount"></em></span>
            <textarea id="f-desc" class="inp" rows="3" maxlength="400"></textarea>
            <span class="fld-hint">검색결과·카드에 그대로 노출됩니다. 120~160자 권장.</span>
          </label>

          <label class="fld">
            <span class="fld-label">주소(슬러그) <b>*</b></span>
            <input id="f-slug" class="inp" type="text" placeholder="samsung-hbm-outlook" />
            <span class="fld-hint">영소문자·숫자·하이픈. 발행 뒤 바꾸면 기존 링크가 끊깁니다.</span>
          </label>

          <label class="fld">
            <span class="fld-label">카테고리</span>
            <select id="f-cat" class="inp"></select>
          </label>

          <label class="fld">
            <span class="fld-label">태그</span>
            <input id="f-tags" class="inp" type="text" list="tagList" placeholder="쉼표로 구분: 반도체, HBM" />
            <datalist id="tagList"></datalist>
          </label>

          <div class="fld">
            <span class="fld-label">커버 이미지</span>
            <select id="f-cover" class="inp"></select>
            <img id="coverPrev" class="cover-prev" alt="" hidden />
          </div>

          <div class="fld">
            <span class="fld-label">다루는 종목</span>
            <input id="f-ticker" class="inp" type="text" list="stockList" placeholder="종목명 또는 6자리 코드 → Enter" />
            <datalist id="stockList"></datalist>
            <div class="chips" id="tickerChips"></div>
          </div>

          <fieldset class="fld pub">
            <legend class="fld-label">발행</legend>
            <div class="radios">
              <label class="radio"><input type="radio" name="pub" value="now" checked /> <span>즉시 게시</span></label>
              <label class="radio"><input type="radio" name="pub" value="schedule" /> <span>예약</span></label>
              <label class="radio"><input type="radio" name="pub" value="draft" /> <span>비공개</span></label>
            </div>
            <input id="f-when" class="inp" type="datetime-local" disabled />
            <span class="fld-hint" id="whenHint"></span>
          </fieldset>
        </div>

        <!-- 본문 -->
        <div class="panel body-panel">
          <div class="body-tabs">
            <span class="body-label">본문</span>
            <span class="fld-hint">보이는 그대로 씁니다. 아래 탭에서 Markdown 원문으로 바꿀 수 있습니다.</span>
            <span class="spacer"></span>
            <span class="muted small" id="bodyCount"></span>
          </div>
          <div id="editor" class="editor-host"></div>
        </div>
      </div>
    </section>
  </div>

  <!-- 토스트 -->
  <div class="toast" id="toast" hidden></div>
</BaseLayout>

<script>
  import Editor from '@toast-ui/editor';
  import '@toast-ui/editor/dist/toastui-editor.css';
  import '@toast-ui/editor/dist/theme/toastui-editor-dark.css';
  import '@toast-ui/editor/dist/i18n/ko-kr';

  type Meta = {
    title: string;
    description: string;
    pubDate: string;
    updatedDate?: string;
    tags: string[];
    category?: string | null;
    cover?: string | null;
    tickers: { code: string; name: string }[];
    draft: boolean;
  };
  type Row = Meta & { file: string; slug: string; sha: string; status: string; broken?: boolean };

  const CFG = JSON.parse(document.getElementById('admin-config')!.textContent!);
  const TOKEN_KEY = 'outvest.admin.token';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const lock = $('lockScreen');
  const overlay = $('overlay');
  const modal = overlay.querySelector('.modal') as HTMLElement;
  const pw = $<HTMLInputElement>('pw');
  const pwError = $('pwError');
  const consoleEl = $('console');

  let token = sessionStorage.getItem(TOKEN_KEY) ?? '';
  let rows: Row[] = [];
  /** 편집 중인 글. file 이 null 이면 새 글. */
  let cur: { file: string | null; sha: string | null; meta: Meta; body: string } | null = null;
  let dirty = false;
  let tickers: { code: string; name: string }[] = [];
  let stocks: { code: string; name: string }[] = [];

  // ── 공통 ─────────────────────────────────────────────────
  function toast(msg: string, kind: 'ok' | 'err' = 'ok') {
    const t = $('toast');
    t.textContent = msg;
    t.className = `toast is-${kind}`;
    t.hidden = false;
    clearTimeout((t as any)._h);
    (t as any)._h = setTimeout(() => (t.hidden = true), 4200);
  }

  function notice(el: HTMLElement, msg: string | null, kind: 'warn' | 'err' = 'err') {
    if (!msg) { el.hidden = true; return; }
    el.textContent = msg;
    el.className = `notice is-${kind}`;
    el.hidden = false;
  }

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]!);

  async function api(path: string, init: RequestInit = {}): Promise<any> {
    const res = await fetch(path, {
      ...init,
      headers: { ...(init.headers ?? {}), 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
    });
    if (res.status === 401) { logout(); throw new Error('세션이 만료됐습니다. 다시 로그인하세요.'); }
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data?.error ?? `요청 실패 (${res.status})`);
    return data;
  }

  // 시각은 항상 한국 시간으로 다룬다 (브라우저 시간대와 무관하게).
  const KST = 9 * 60 * 60 * 1000;
  const toInput = (iso: string) => {
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? '' : new Date(d.getTime() + KST).toISOString().slice(0, 16);
  };
  const fromInput = (v: string) => (v ? `${v}:00+09:00` : '');
  const nowKSTInput = () => new Date(Date.now() + KST).toISOString().slice(0, 16);
  const fmtWhen = (iso: string) => {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso || '—';
    return new Intl.DateTimeFormat('ko-KR', {
      timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false,
    }).format(d);
  };

  // ── 인증 ─────────────────────────────────────────────────
  function openModal() {
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    pwError.hidden = true;
    pw.value = '';
    setTimeout(() => pw.focus(), 30);
  }
  function closeModal() {
    overlay.hidden = true;
    document.body.style.overflow = '';
  }
  function reject(msg: string) {
    pwError.textContent = msg;
    pwError.hidden = false;
    modal.classList.remove('shake');
    void modal.offsetWidth;
    modal.classList.add('shake');
    pw.select();
  }
  function unlock() {
    closeModal();
    lock.hidden = true;
    consoleEl.hidden = false;
  }
  function logout() {
    token = '';
    sessionStorage.removeItem(TOKEN_KEY);
    consoleEl.hidden = true;
    lock.hidden = false;
    show('dash');
  }

  async function login() {
    const btn = $<HTMLButtonElement>('submitBtn');
    btn.disabled = true;
    btn.textContent = '확인 중…';
    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw.value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { reject(data?.error ?? '로그인에 실패했습니다'); return; }
      token = data.token;
      sessionStorage.setItem(TOKEN_KEY, token);
      unlock();
    } catch {
      reject('서버에 연결하지 못했습니다');
    } finally {
      btn.disabled = false;
      btn.textContent = '확인';
    }
  }

  $('trigger').addEventListener('click', openModal);
  $('closeBtn').addEventListener('click', closeModal);
  $('submitBtn').addEventListener('click', login);
  pw.addEventListener('keydown', (e) => { if (e.key === 'Enter') login(); });
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) closeModal(); });
  $('logoutBtn').addEventListener('click', logout);

  // ── 뷰 전환 ───────────────────────────────────────────────
  const TITLES: Record<string, string> = { dash: '콘텐츠 대시보드', list: '글관리', edit: '글 편집' };
  function show(view: 'dash' | 'list' | 'edit') {
    for (const v of ['dash', 'list', 'edit']) $(`view-${v}`).hidden = v !== view;
    document.querySelectorAll<HTMLElement>('.c-tabs .tab').forEach((b) =>
      b.classList.toggle('is-on', b.dataset.view === view)
    );
    $('cTitle').textContent = TITLES[view];
    window.scrollTo({ top: 0 });
  }
  function leaveEditor(): boolean {
    if (!$('view-edit').hidden && dirty) return confirm('저장하지 않은 변경이 있습니다. 나가시겠습니까?');
    return true;
  }
  document.querySelectorAll<HTMLElement>('.c-tabs .tab').forEach((b) =>
    b.addEventListener('click', () => {
      if (!leaveEditor()) return;
      const v = b.dataset.view as 'dash' | 'list';
      show(v);
      if (v === 'list') loadList();
    })
  );

  // ── 목록 ─────────────────────────────────────────────────
  const STATUS_LABEL: Record<string, string> = { published: '게시', scheduled: '예약', draft: '비공개' };

  async function loadList() {
    const tb = $('listBody');
    tb.innerHTML = '<tr><td colspan="5" class="empty">불러오는 중…</td></tr>';
    notice($('listNotice'), null);
    try {
      const data = await api('/api/admin/posts');
      rows = data.posts;
      renderList();
    } catch (e: any) {
      tb.innerHTML = '<tr><td colspan="5" class="empty">목록을 불러오지 못했습니다</td></tr>';
      notice($('listNotice'), e.message);
    }
  }

  function renderList() {
    const st = $<HTMLSelectElement>('fStatus').value;
    const kw = $<HTMLInputElement>('fSearch').value.trim().toLowerCase();
    const view = rows.filter(
      (r) =>
        (!st || r.status === st) &&
        (!kw || r.title.toLowerCase().includes(kw) || r.slug.toLowerCase().includes(kw))
    );

    const counts: Record<string, number> = { published: 0, scheduled: 0, draft: 0 };
    for (const r of rows) counts[r.status] = (counts[r.status] ?? 0) + 1;
    $('listCount').textContent =
      `전체 ${rows.length} · 게시 ${counts.published} · 예약 ${counts.scheduled} · 비공개 ${counts.draft}`;

    const tb = $('listBody');
    if (!view.length) {
      tb.innerHTML = `<tr><td colspan="5" class="empty">${rows.length ? '조건에 맞는 글이 없습니다' : '아직 글이 없습니다'}</td></tr>`;
      return;
    }

    tb.innerHTML = '';
    for (const r of view) {
      const tr = document.createElement('tr');
      if (r.broken) tr.className = 'is-broken';
      const td = (html: string, cls = '') => {
        const c = document.createElement('td');
        if (cls) c.className = cls;
        c.innerHTML = html;
        return c;
      };

      tr.appendChild(td(`<span class="st st-${r.status}">${STATUS_LABEL[r.status] ?? r.status}</span>`));
      tr.appendChild(
        td(`<span class="pt-title">${esc(r.title)}</span><span class="pt-slug">/${esc(r.slug)}/</span>`, 'pt-cell')
      );
      tr.appendChild(
        td(r.category ? `<span class="chip">${esc(r.category)}</span>` : '<span class="muted">—</span>')
      );
      tr.appendChild(td(`<span class="when">${fmtWhen(r.pubDate)}</span>`));

      const act = document.createElement('td');
      act.className = 'ta-r';
      const edit = document.createElement('button');
      edit.className = 'mini-btn';
      edit.type = 'button';
      edit.textContent = '수정';
      edit.addEventListener('click', () => openEditor(r.file));
      act.appendChild(edit);
      if (r.status === 'published') {
        const a = document.createElement('a');
        a.className = 'mini-btn';
        a.href = `/posts/${r.slug}/`;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = '보기';
        act.appendChild(a);
      }
      tr.appendChild(act);
      tb.appendChild(tr);
    }
  }

  $('fStatus').addEventListener('change', renderList);
  $('fSearch').addEventListener('input', renderList);
  $('reloadBtn').addEventListener('click', loadList);
  $('backBtn').addEventListener('click', () => { if (leaveEditor()) { show('list'); loadList(); } });

  // ── 편집기 ───────────────────────────────────────────────
  function fillSelect(el: HTMLSelectElement, items: string[], emptyLabel: string) {
    el.innerHTML = '';
    el.appendChild(new Option(emptyLabel, ''));
    for (const v of items) el.appendChild(new Option(v, v));
  }
  fillSelect($<HTMLSelectElement>('f-cat'), CFG.categories, '— 선택 안 함 —');
  fillSelect($<HTMLSelectElement>('f-cover'), CFG.covers, '— 기본 커버 —');
  $('tagList').innerHTML = CFG.allTags.map((t: string) => `<option value="${esc(t)}"></option>`).join('');

  fetch('/stocks.json')
    .then((r) => r.json())
    .then((list) => {
      stocks = list;
      $('stockList').innerHTML = list
        .map((s: any) => `<option value="${s.code} ${esc(s.name)}"></option>`)
        .join('');
    })
    .catch(() => {});

  function renderChips() {
    const box = $('tickerChips');
    box.innerHTML = '';
    tickers.forEach((t, i) => {
      const chip = document.createElement('span');
      chip.className = 'chip tk';
      chip.textContent = `${t.name} ${t.code}`;
      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'chip-x';
      x.setAttribute('aria-label', `${t.name} 제거`);
      x.textContent = '×';
      x.addEventListener('click', () => { tickers.splice(i, 1); renderChips(); markDirty(); });
      chip.appendChild(x);
      box.appendChild(chip);
    });
  }

  $('f-ticker').addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key !== 'Enter') return;
    e.preventDefault();
    const el = $<HTMLInputElement>('f-ticker');
    const v = el.value.trim();
    if (!v) return;
    const code = (v.match(/\b\d{6}\b/) ?? [])[0];
    const found = code
      ? stocks.find((s) => s.code === code)
      : (stocks.find((s) => s.name === v) ?? stocks.find((s) => s.name.startsWith(v)));
    if (!found) { toast('종목을 찾지 못했습니다. 목록에서 골라주세요.', 'err'); return; }
    if (!tickers.some((t) => t.code === found.code)) tickers.push({ code: found.code, name: found.name });
    el.value = '';
    renderChips();
    markDirty();
  });

  function markDirty() { dirty = true; }
  ['f-title', 'f-desc', 'f-slug', 'f-cat', 'f-tags', 'f-cover', 'f-when'].forEach((id) =>
    $(id).addEventListener('input', markDirty)
  );

  // ── 본문 위지윅 에디터 ────────────────────────────────────
  // 편집 영역(.toastui-editor-contents)에 기사 본문과 같은 CSS 를 입혀
  // "쓰는 화면 = 나가는 화면"이 되게 한다 (스타일은 아래 <style> 참조).
  // 높이는 % 가 아니라 px 로 준다. 이 에디터는 편집 뷰가 숨겨진(display:none)
  // 상태에서 만들어지는데, 그때 100% 를 주면 0px 로 굳어 본문이 보이지 않는다.
  const EDITOR_H = () => (window.innerWidth < 900 ? 520 : 680);
  const editor = new Editor({
    el: $('editor'),
    height: `${EDITOR_H()}px`,
    initialEditType: 'wysiwyg',
    previewStyle: 'vertical',
    language: 'ko-KR',
    usageStatistics: false,
    theme: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
    placeholder: '본문을 입력하세요.',
    autofocus: false,
    toolbarItems: [
      ['heading', 'bold', 'italic', 'strike'],
      ['hr', 'quote'],
      ['ul', 'ol'],
      ['table', 'image', 'link'],
      ['code', 'codeblock'],
    ],
    hooks: {
      // 이미지 파일 업로드 경로는 아직 없다. 붙여넣기·드래그도 여기로 들어온다.
      addImageBlobHook: () => {
        toast('이미지 파일 업로드는 아직 지원하지 않습니다. URL 탭에 /images/파일명 을 넣어주세요.', 'err');
        return false;
      },
    },
  });

  window.addEventListener('resize', () => editor.setHeight(`${EDITOR_H()}px`));

  const getBody = () => editor.getMarkdown();
  const setBody = (v: string) => editor.setMarkdown(v ?? '', false);
  const updateBodyCount = () => { $('bodyCount').textContent = `${getBody().length}자`; };
  editor.on('change', () => { markDirty(); updateBodyCount(); });

  /**
   * 글을 불러온 직후의 에디터 본문. 저장할 때 이 값과 같으면
   * "사용자가 본문을 건드리지 않았다"는 뜻이므로 원본 마크다운을 그대로 보낸다.
   * (위지윅은 목록 기호를 - 에서 * 로 바꾸는 식의 서식 정규화를 한다.
   *  본문을 고치지도 않았는데 그런 커밋이 쌓이면 이력이 더러워진다.)
   */
  let baselineBody = '';

  /**
   * 위지윅이 되살리지 못하는 구문 — 인용문 안의 소제목(`> ## 제목`).
   * 실측 결과 이 한 가지만 평문으로 내려앉는다. 이런 글은 마크다운 모드로 연다.
   */
  const RISKY = /^>\s*#{1,6}\s/m;
  document.querySelectorAll('input[name="pub"]').forEach((r) =>
    r.addEventListener('change', () => { syncPub(); markDirty(); })
  );

  $('f-cover').addEventListener('change', () => {
    const v = $<HTMLSelectElement>('f-cover').value;
    const img = $<HTMLImageElement>('coverPrev');
    img.hidden = !v;
    if (v) img.src = v;
  });
  $('f-desc').addEventListener('input', () => {
    $('descCount').textContent = `${$<HTMLTextAreaElement>('f-desc').value.length}자`;
  });

  const pubMode = () => (document.querySelector('input[name="pub"]:checked') as HTMLInputElement).value;
  function setPubMode(v: string) {
    (document.querySelector(`input[name="pub"][value="${v}"]`) as HTMLInputElement).checked = true;
    syncPub();
  }
  function syncPub() {
    const m = pubMode();
    const when = $<HTMLInputElement>('f-when');
    when.disabled = m === 'now';
    if (m === 'schedule' && !when.value) {
      // 기본 제안: 다음 날 아침 8시(장 시작 전)
      const d = new Date(Date.now() + KST + 24 * 3600e3);
      d.setUTCHours(8, 0, 0, 0);
      when.value = d.toISOString().slice(0, 16);
    }
    $('whenHint').textContent =
      m === 'now'
        ? '저장 즉시 발행됩니다. 사이트 반영까지 1~3분 걸립니다.'
        : m === 'schedule'
          ? '예약 시각(한국 시간)이 지나면 10분 안에 자동으로 게시됩니다.'
          : '사이트에 노출되지 않습니다. 나중에 게시할 때 위 시각이 발행일이 됩니다.';
  }

  const blankMeta = (): Meta => ({
    title: '', description: '', pubDate: '', tags: [],
    category: null, cover: null, tickers: [], draft: false,
  });

  function fillForm(meta: Meta, body: string) {
    $<HTMLInputElement>('f-title').value = meta.title;
    $<HTMLTextAreaElement>('f-desc').value = meta.description;
    $<HTMLSelectElement>('f-cat').value = meta.category ?? '';
    $<HTMLInputElement>('f-tags').value = meta.tags.join(', ');
    $<HTMLSelectElement>('f-cover').value = meta.cover ?? '';
    $<HTMLSelectElement>('f-cover').dispatchEvent(new Event('change'));
    setBody(body);
    tickers = meta.tickers.map((t) => ({ ...t }));
    renderChips();

    $<HTMLInputElement>('f-when').value = meta.pubDate ? toInput(meta.pubDate) : '';
    if (meta.draft) setPubMode('draft');
    else if (meta.pubDate && new Date(meta.pubDate).getTime() > Date.now()) setPubMode('schedule');
    else setPubMode(meta.pubDate ? 'schedule' : 'now');

    $('descCount').textContent = `${meta.description.length}자`;
    updateBodyCount();
    baselineBody = getBody();
  }

  $('newBtn').addEventListener('click', () => {
    cur = { file: null, sha: null, meta: blankMeta(), body: '' };
    editor.changeMode('wysiwyg', true);
    fillForm(blankMeta(), '');
    setPubMode('now');
    $<HTMLInputElement>('f-slug').value = '';
    $('editWhich').textContent = '새 글';
    $('delBtn').hidden = true;
    notice($('editNotice'), null);
    dirty = false;
    show('edit');
    $('f-title').focus();
  });

  async function openEditor(file: string) {
    notice($('editNotice'), null);
    show('edit');
    $('editWhich').textContent = '불러오는 중…';
    try {
      const d = await api(`/api/admin/post?file=${encodeURIComponent(file)}`);
      cur = { file: d.file, sha: d.sha, meta: d.meta, body: d.body };

      // 위지윅이 못 살리는 구문이 있으면 마크다운 모드로 열고 그 이유를 말해준다.
      const risky = RISKY.test(d.body);
      editor.changeMode(risky ? 'markdown' : 'wysiwyg', true);
      fillForm(d.meta, d.body);
      if (risky) {
        notice(
          $('editNotice'),
          '이 글에는 인용문 안 소제목(> ## …)이 있어 Markdown 모드로 열었습니다. 위지윅으로 바꾸면 그 소제목이 평범한 문단이 됩니다.',
          'warn'
        );
      }
      $<HTMLInputElement>('f-slug').value = d.slug;
      $('editWhich').textContent = `${STATUS_LABEL[d.status] ?? d.status} · ${d.file}`;
      $('delBtn').hidden = false;
      dirty = false;
    } catch (e: any) {
      $('editWhich').textContent = '';
      notice($('editNotice'), e.message);
    }
  }

  function collect() {
    const m = pubMode();
    const whenVal = $<HTMLInputElement>('f-when').value;
    const edited = getBody();
    return {
      slug: $<HTMLInputElement>('f-slug').value.trim(),
      // 본문을 손대지 않았으면 원본 그대로 — 서식만 바뀌는 커밋을 만들지 않는다.
      body: edited === baselineBody ? (cur?.body ?? edited) : edited,
      meta: {
        title: $<HTMLInputElement>('f-title').value.trim(),
        description: $<HTMLTextAreaElement>('f-desc').value.trim(),
        pubDate: m === 'now' ? fromInput(nowKSTInput()) : fromInput(whenVal || nowKSTInput()),
        updatedDate: cur?.meta.updatedDate,
        tags: $<HTMLInputElement>('f-tags').value.split(',').map((s) => s.trim()).filter(Boolean),
        category: $<HTMLSelectElement>('f-cat').value || null,
        cover: $<HTMLSelectElement>('f-cover').value || null,
        tickers,
        draft: m === 'draft',
      } as Meta,
    };
  }

  async function save() {
    const btn = $<HTMLButtonElement>('saveBtn');
    const payload = collect();

    if (pubMode() === 'schedule' && new Date(payload.meta.pubDate).getTime() <= Date.now()) {
      notice($('editNotice'), '예약 시각이 이미 지났습니다. 미래 시각을 고르거나 “즉시 게시”를 선택하세요.', 'warn');
      return;
    }

    btn.disabled = true;
    btn.textContent = '저장 중…';
    notice($('editNotice'), null);
    try {
      const res = await api('/api/admin/post', {
        method: 'PUT',
        body: JSON.stringify({ file: cur?.file ?? null, sha: cur?.sha ?? null, ...payload }),
      });
      cur = { file: res.file, sha: res.sha, meta: payload.meta, body: payload.body };
      baselineBody = getBody(); // 저장 후 기준선 갱신 — 연속 저장 시 원본 판정이 어긋나지 않게
      dirty = false;
      $('editWhich').textContent = `${STATUS_LABEL[res.status]} · ${res.file}`;
      $('delBtn').hidden = false;
      toast(
        res.status === 'scheduled'
          ? '예약 등록했습니다. 시각이 되면 자동 게시됩니다.'
          : res.status === 'draft'
            ? '비공개로 저장했습니다.'
            : '저장했습니다. 사이트 반영까지 1~3분 걸립니다.'
      );
      if (res.renamed) toast('주소가 바뀌었습니다. 기존 링크는 더 이상 열리지 않습니다.', 'err');
    } catch (e: any) {
      notice($('editNotice'), e.message);
    } finally {
      btn.disabled = false;
      btn.textContent = '저장';
    }
  }
  $('saveBtn').addEventListener('click', save);

  $('delBtn').addEventListener('click', async () => {
    if (!cur?.file || !cur.sha) return;
    const t = $<HTMLInputElement>('f-title').value;
    if (!confirm(`"${t}" 글을 삭제합니다.\n사이트에서 사라집니다. (git 이력에는 남아 되돌릴 수 있습니다)`)) return;
    try {
      await api('/api/admin/post', {
        method: 'DELETE',
        body: JSON.stringify({ file: cur.file, sha: cur.sha }),
      });
      dirty = false;
      toast('삭제했습니다.');
      show('list');
      loadList();
    } catch (e: any) {
      notice($('editNotice'), e.message);
    }
  });

  window.addEventListener('beforeunload', (e) => {
    if (!$('view-edit').hidden && dirty) { e.preventDefault(); e.returnValue = ''; }
  });

  // ── 시작 ─────────────────────────────────────────────────
  syncPub();
  if (token) unlock();
</script>

<style>
  /* HTML hidden 속성이 아래 display 규칙을 반드시 이기도록 */
  [hidden] { display: none !important; }

  /* ── 잠금 / 모달 ─────────────────────────────────────── */
  .lock { min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; }
  .lock-msg { font-size: 1.05rem; color: var(--muted); margin: 0; }
  .trg { cursor: default; }

  .ov {
    position: fixed; inset: 0; z-index: 100; padding: 20px;
    background: rgba(0, 0, 0, 0.45);
    display: flex; align-items: center; justify-content: center;
  }
  .modal {
    position: relative; width: 100%; max-width: 340px;
    background: var(--bg); border: 1px solid var(--border-strong);
    border-radius: 16px; padding: 28px 24px 24px; text-align: center;
  }
  .modal-x {
    position: absolute; top: 8px; right: 12px; padding: 0;
    background: none; border: 0; font-size: 1.4rem; line-height: 1;
    color: var(--faint); cursor: pointer;
  }
  .modal-title { font-size: 1.05rem; margin: 0 0 16px; }
  .pw-input {
    width: 100%; padding: 10px 12px; text-align: center; font-family: inherit;
    border: 1px solid var(--border-strong); border-radius: 8px;
    background: var(--page); color: var(--fg); font-size: 0.95rem;
  }
  .pw-error { color: #d94b4b; font-size: 0.82rem; margin: 8px 0 0; }
  .pw-submit {
    width: 100%; margin-top: 14px; padding: 10px; font-family: inherit;
    background: var(--accent); color: #fff; border: 0; border-radius: 8px;
    font-weight: 700; font-size: 0.92rem; cursor: pointer;
  }
  .pw-submit:disabled { opacity: 0.6; cursor: default; }
  .shake { animation: shake 0.3s; }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  /* ── 콘솔 골격 ───────────────────────────────────────── */
  .console { padding-bottom: 60px; }
  .c-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 8px 0 22px; }
  .c-head h1 { font-size: 1.5rem; margin: 4px 0 0; }
  .c-tabs { display: flex; align-items: center; gap: 6px; }
  .tab {
    padding: 7px 14px; font-size: 0.88rem; font-weight: 700; font-family: inherit;
    color: var(--muted); background: transparent;
    border: 1px solid transparent; border-radius: 999px; cursor: pointer;
  }
  .tab:hover { color: var(--fg); }
  .tab.is-on { color: var(--accent-ink); background: var(--accent-wash); border-color: var(--accent); }

  .primary-btn {
    padding: 8px 16px; font-size: 0.88rem; font-weight: 700; font-family: inherit;
    color: #fff; background: var(--accent); border: 1px solid var(--accent);
    border-radius: 8px; cursor: pointer;
  }
  .primary-btn:disabled { opacity: 0.6; cursor: default; }
  .ghost-btn {
    display: inline-flex; align-items: center; padding: 8px 14px; font-family: inherit;
    font-size: 0.85rem; font-weight: 600; color: var(--fg);
    background: var(--bg); border: 1px solid var(--border-strong);
    border-radius: 8px; cursor: pointer;
  }
  .ghost-btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .ghost-btn.danger:hover { border-color: #d94b4b; color: #d94b4b; }
  .mini-btn {
    display: inline-flex; align-items: center; padding: 4px 10px; margin-left: 6px; font-family: inherit;
    font-size: 0.8rem; font-weight: 600; color: var(--muted);
    background: transparent; border: 1px solid var(--border-strong);
    border-radius: 6px; cursor: pointer;
  }
  .mini-btn:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .spacer { flex: 1; }
  .small { font-size: 0.82rem; }
  .ta-r { text-align: right; white-space: nowrap; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 10px; }

  .panel { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; margin-bottom: 18px; }
  .panel-title { font-size: 0.95rem; margin: 0 0 12px; }

  .notice { padding: 10px 14px; border-radius: 8px; font-size: 0.86rem; margin: 0 0 14px; border: 1px solid; }
  .notice.is-err { color: #d94b4b; border-color: #d94b4b; background: rgba(217, 75, 75, 0.07); }
  .notice.is-warn { color: #b5820e; border-color: #d8b25e; background: rgba(216, 178, 94, 0.1); }

  /* ── 대시보드 ─────────────────────────────────────────── */
  .tiles { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 18px; }
  .tile { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 18px 16px; display: flex; flex-direction: column; gap: 4px; }
  .tile-val { font-size: 1.7rem; font-weight: 800; color: var(--fg); font-variant-numeric: tabular-nums; }
  .tile-label { font-size: 0.82rem; color: var(--muted); }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; }
  .rlist { display: flex; flex-direction: column; }
  .ritem { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 10px 0; border-top: 1px solid var(--border); color: inherit; }
  .ritem:first-child { border-top: none; }
  .ritem:hover { text-decoration: none; }
  .ritem:hover .ri-title { color: var(--accent); }
  .ri-title { font-size: 0.94rem; font-weight: 600; line-height: 1.45; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ri-meta { flex: none; display: inline-flex; align-items: center; gap: 8px; }
  .ri-date { font-size: 0.78rem; color: var(--faint); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .badge { font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; white-space: nowrap; border: 1px solid var(--border-strong); color: var(--muted); }
  .taglist { display: flex; flex-direction: column; }
  .tagrow { display: flex; align-items: center; justify-content: space-between; padding: 9px 0; border-top: 1px solid var(--border); font-size: 0.9rem; }
  .tagrow:first-child { border-top: none; }
  .tag-count { color: var(--muted); font-weight: 700; font-variant-numeric: tabular-nums; }
  .months { display: flex; flex-direction: column; gap: 8px; }
  .mrow { display: flex; align-items: center; gap: 12px; }
  .m-label { flex: none; width: 66px; font-size: 0.82rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .m-bar-wrap { flex: 1; height: 10px; background: var(--page); border-radius: 999px; overflow: hidden; }
  .m-bar { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
  .m-count { flex: none; width: 26px; text-align: right; font-size: 0.82rem; font-weight: 700; font-variant-numeric: tabular-nums; }

  /* ── 목록 ────────────────────────────────────────────── */
  .toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .inp {
    width: 100%; padding: 9px 11px; font-size: 0.9rem; font-family: inherit;
    color: var(--fg); background: var(--bg);
    border: 1px solid var(--border-strong); border-radius: 8px;
  }
  .inp:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }
  .inp:disabled { opacity: 0.5; }
  .inp-sm { width: auto; min-width: 140px; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 14px; background: var(--bg); }
  .ptable { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 720px; }
  .ptable th {
    text-align: left; font-size: 0.75rem; font-weight: 700; color: var(--muted);
    padding: 12px 14px; border-bottom: 1px solid var(--border); letter-spacing: 0.04em;
  }
